# Copy to .env.local (gitignored) to override for your machine.

# Where the backend API lives. Unset = http://localhost:8080/api.
# When the site and API are served from the same domain (recommended in production), use: /api
VITE_API_URL=http://localhost:8080/api

# Contact details on the landing page and privacy page. Unset = the defaults in src/config/contact.js.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Map tiles. OpenStreetMap's public tiles are fine for development and light use. For a busy
# public site, use a tile provider (e.g. MapTiler, Stadia Maps, Thunderforest) and your key.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
